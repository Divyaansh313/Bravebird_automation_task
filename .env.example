# Copy to .env and fill in:  cp .env.example .env && chmod 600 .env
# .env is git-ignored. Use your own account only.

# GitHub username or email
PORTAL_USERNAME=

# GitHub password
PORTAL_PASSWORD=

# Base32 TOTP secret: the "setup key" link under the QR code when you add an
# authenticator app (Settings -> Password and authentication). No spaces needed.
TOTP_SECRET=

# ---- Optional ---------------------------------------------------------------

# Default proxy for every run: scheme://[user:pass@]host:port
# BRAVEBIRD_PROXY=http://user:pass@proxy.example:8080

# Named proxy routes, picked per input with "proxy_route": "<ROUTE>"
# BRAVEBIRD_PROXY_EU=socks5://user:pass@eu.proxy.example:1080

# Required when bravebird-serve listens on anything other than 127.0.0.1
# BRAVEBIRD_API_TOKEN=

# Max seconds to wait for another run signing in to the same account (default 300)
# BRAVEBIRD_LOCK_TIMEOUT=300
