# Copy to .env and fill in:  cp .env.example .env && chmod 600 .env
# .env is git-ignored. Use your own account only.

# GitHub username or email
PORTAL_USERNAME=

# GitHub password
PORTAL_PASSWORD=

# Base32 TOTP secret: the "setup key" link under the QR code when you add an
# authenticator app (Settings -> Password and authentication). No spaces needed.
TOTP_SECRET=
